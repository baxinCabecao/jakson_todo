{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jakson ToDo",
  "version": "0.1.0",
  "identifier": "com.baxin.jaksontodo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jakson ToDo",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["com.baxin.jaksontodo", "jaksontodo"]
        }
      ],
      "desktop": {
        "schemes": ["jaksontodo", "com.baxin.jaksontodo"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
